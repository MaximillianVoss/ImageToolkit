<Window x:Class="ImageToolkit.ApiKeyPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenAI API key"
        Width="560"
        Height="320"
        MinWidth="520"
        MinHeight="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7FA">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="22"
                   FontWeight="Bold"
                   Foreground="#0B3440"
                   Text="Введите OpenAI API key" />

        <TextBlock Grid.Row="2"
                   TextWrapping="Wrap"
                   Foreground="#4B5563"
                   Text="Ключ нужен только для распознавания объектов. Его можно сохранить локально в зашифрованный файл для текущего пользователя Windows." />

        <TextBlock Grid.Row="4"
                   FontWeight="SemiBold"
                   Foreground="#0B3440"
                   Text="API key" />

        <TextBox x:Name="ApiKeyTextBox"
                 Grid.Row="5"
                 Margin="0,8,0,0"
                 Padding="10,8"
                 MinHeight="38"
                 VerticalContentAlignment="Center" />

        <StackPanel Grid.Row="6" Margin="0,12,0,0">
            <CheckBox x:Name="SaveLocallyCheckBox"
                      IsChecked="True"
                      Foreground="#1F2937"
                      Content="Сохранить локально для текущего пользователя" />
            <TextBlock x:Name="DiagnosticTextBlock"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap"
                       Foreground="#A61B1B"
                       Visibility="Collapsed" />
        </StackPanel>

        <DockPanel Grid.Row="8" LastChildFill="False">
            <Button Width="120"
                    Margin="0"
                    Padding="12,8"
                    Click="CancelButton_Click"
                    Content="Отмена" />
            <Button Width="140"
                    Margin="12,0,0,0"
                    Padding="12,8"
                    Background="#0F4C5C"
                    Foreground="White"
                    BorderBrush="#0F4C5C"
                    FontWeight="SemiBold"
                    Click="SaveButton_Click"
                    Content="Продолжить" />
        </DockPanel>
    </Grid>
</Window>
