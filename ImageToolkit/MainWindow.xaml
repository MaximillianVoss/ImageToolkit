<Window x:Class="ImageToolkit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ImageToolkit"
        Width="1360"
        Height="840"
        MinWidth="1180"
        MinHeight="720"
        Background="#E8EDF2">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#F9FBFD" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0F4C5C" />
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#0B3440" />
        <SolidColorBrush x:Key="CanvasBrush" Color="#111827" />
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1F2937" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Padding="22"
                Background="{StaticResource PanelBrush}"
                CornerRadius="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentDarkBrush}">
                        ImageToolkit
                    </TextBlock>
                    <TextBlock Margin="0,8,0,20"
                               TextWrapping="Wrap"
                               Foreground="#4B5563">
                        Настольное средство для базовой обработки изображений: загрузка, фильтры, зеркалирование, поворот и сохранение результата.
                    </TextBlock>

                    <Button x:Name="LoadImageButton" Click="LoadImageButton_Click">
                        Открыть изображение
                    </Button>
                    <Button x:Name="ApplyOperationButton" Click="ApplyOperationButton_Click">
                        Применить операцию
                    </Button>
                    <Button x:Name="ResetButton" Click="ResetButton_Click">
                        Сбросить к исходному
                    </Button>
                    <Button x:Name="SaveImageButton" Click="SaveImageButton_Click">
                        Сохранить результат
                    </Button>

                    <Separator Margin="0,6,0,18" />

                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentDarkBrush}">
                        Операция
                    </TextBlock>
                    <ComboBox x:Name="OperationComboBox"
                              Margin="0,12,0,12"
                              Padding="10,6"
                              SelectionChanged="OperationComboBox_SelectionChanged" />
                    <TextBlock x:Name="OperationDescriptionTextBlock"
                               Margin="0,0,0,18"
                               TextWrapping="Wrap"
                               Foreground="#4B5563" />

                    <TextBlock x:Name="ParameterNameTextBlock"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentDarkBrush}" />
                    <Slider x:Name="ParameterSlider"
                            Margin="0,10,0,4"
                            IsSnapToTickEnabled="True"
                            TickFrequency="1"
                            ValueChanged="ParameterSlider_ValueChanged" />
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock x:Name="ParameterHintTextBlock"
                                   Width="220"
                                   TextWrapping="Wrap"
                                   Foreground="#4B5563" />
                        <TextBlock x:Name="ParameterValueTextBlock"
                                   HorizontalAlignment="Right"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentDarkBrush}" />
                    </DockPanel>

                    <Separator Margin="0,8,0,18" />

                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentDarkBrush}">
                        Сведения
                    </TextBlock>
                    <TextBlock x:Name="ImageInfoTextBlock"
                               Margin="0,12,0,8"
                               TextWrapping="Wrap"
                               Foreground="#4B5563" />
                    <TextBlock x:Name="StatusTextBlock"
                               TextWrapping="Wrap"
                               Foreground="#4B5563" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="22"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="20">
                <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentDarkBrush}">
                    Область просмотра
                </TextBlock>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="18"
                        Background="{StaticResource PanelBrush}"
                        CornerRadius="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentDarkBrush}">
                            Исходное изображение
                        </TextBlock>
                        <Border Grid.Row="1"
                                Margin="0,14,0,0"
                                Background="{StaticResource CanvasBrush}"
                                CornerRadius="16">
                            <Grid>
                                <TextBlock x:Name="OriginalPlaceholderTextBlock"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#CBD5E1"
                                           FontSize="18"
                                           Text="Изображение еще не загружено" />
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto">
                                    <Image x:Name="OriginalImage"
                                           Margin="16"
                                           Stretch="Uniform" />
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Padding="18"
                        Background="{StaticResource PanelBrush}"
                        CornerRadius="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentDarkBrush}">
                            Текущий результат / предпросмотр
                        </TextBlock>
                        <Border Grid.Row="1"
                                Margin="0,14,0,0"
                                Background="{StaticResource CanvasBrush}"
                                CornerRadius="16">
                            <Grid>
                                <TextBlock x:Name="ResultPlaceholderTextBlock"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#CBD5E1"
                                           FontSize="18"
                                           Text="Предпросмотр появится после загрузки" />
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto">
                                    <Image x:Name="ResultImage"
                                           Margin="16"
                                           Stretch="Uniform" />
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
